{{!--
    Stylesheets and head scripts.

    Load order matters. site.css is the bundled antora-default-ui, which has no
    CSS custom properties and paints its colours literally; dbz-antora.css
    introduces the design tokens and restates those colours against them;
    debezium-antora.css then applies the Debezium-specific layout on top.
    Reordering any of the three loses the theme.
--}}
<link rel="stylesheet" href="{{uiRootPath}}/css/site.css">
<link rel="stylesheet" href="{{uiRootPath}}/css/dbz-antora.css">
<link rel="stylesheet" href="{{uiRootPath}}/css/debezium-antora.css">
<link rel="stylesheet" href="{{uiRootPath}}/css/highlightjs-dark.css">

{{!--
    Applied before first paint so the page is painted on the right ground
    rather than flashing white on the way to dark. Dark is the default and a
    stored choice wins, exactly as in _includes/dbz/head.html.

    The documentation is served from the same origin as the rest of the site,
    so this reads the very key the Jekyll pages write. A visitor who has chosen
    light there arrives here already in light.
--}}
<meta name="theme-color" content="#090F1B">
<script>
  (function () {
    var theme = 'dark';
    try {
      var stored = localStorage.getItem('dbz-theme');
      if (stored === 'light' || stored === 'dark') theme = stored;
    } catch (e) { /* private browsing */ }
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

{{!--
    jQuery is required by the inline script in layouts/default.hbs and by the
    floating scrollbar plugin below. It is served from the UI bundle rather
    than from static.jboss.org, which put a third-party host in the critical
    path of every documentation page.
--}}
<script src="{{uiRootPath}}/js/vendor/jquery.min.js"></script>
<script src="{{uiRootPath}}/js/jquery.ba-floatingscrollbar.js"></script>
