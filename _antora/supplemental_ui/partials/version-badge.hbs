{{!--
    Status badge for one entry of page.versions, matching the badges the
    navbar puts beside its version links (see dbz-navbar.hbs).

    The navbar derives "latest stable" / "stable" / "development" from
    _data/releases at generation time, which Antora cannot read, so the same
    answer is taken from the playbook attributes instead: version-current is
    the latest stable series and version-devel the series under development.
    `nightly` is the main branch and is always development.
--}}
{{#if (eq ./displayVersion 'nightly')}}
<span class="dbz-badge dbz-badge--dev">development</span>
{{else if (eq ./displayVersion @root.page.attributes.version-devel)}}
<span class="dbz-badge dbz-badge--dev">development</span>
{{else if (eq ./displayVersion @root.page.attributes.version-current)}}
<span class="dbz-badge dbz-badge--stable">latest stable</span>
{{else}}
<span class="dbz-badge dbz-badge--stable">stable</span>
{{/if}}
